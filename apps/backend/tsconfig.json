{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "rootDirs": ["./", "../../shared"],
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../shared/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "config/**/*", "../../shared/**/*"]
}